\b\cf1\insrsid9600684\charrsid9774027 
\par }\pard \ltrpar\ql \li0\ri0\sb120\sa120\widctlpar\wrapdefault\faauto\adjustright\rin0\lin0\itap0 {\rtlch\fcs1 \ab\af0 \ltrch\fcs0 \b\cf1\insrsid9600684\charrsid9774027 Accelerated program: }{\rtlch\fcs1 \af0 \ltrch\fcs0 \cf1\insrsid9600684\charrsid9774027 
