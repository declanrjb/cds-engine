id"},"navigation":{"@id":"http:\u002F\u002F172.16.140.7:8080\u002Fyc1\u002Finstitutional-effectiveness\u002Fdata\u002F2024-2025_cds_york_web.pdf\u002F@navigation","items":[{"@id":"http:\u002F\u002F172.16.140.7:8080\u002Fyc1\u002Finstitutional-effectiveness","description":"","items":[],"review_state":null,"title":"Home"},{"@id":"http:\u002F\u002F172.16.140.7:8080\u002Fyc1\u002Finstitutional-effectiveness\u002Fassessment","description":"Assessment takes place within the Institutional Effectiveness Framework, supported by the structure and process outlined in the York College Institutional Effectiveness Plan.","items":[{"@id":"http:\u002F\u002F172.16.140.7:8080\u002Fyc1\u002Finstitutional-effectiveness\u002Fassessment\u002Facademic","description":"Program assessment measures Student Learning Outcomes (SLOs) derived from program goals.  SLOs are defined as specific observable and measurable statements that indicate the knowledge, skills, abilities, and values that a student is expected to attain upon completion of a learning activity.","items":[],"review_state":"published","title":"Academic Program Assessment","use_view_action_in_listings":false},{"@id":"http:\u002F\u002F172.16.140.7:8080\u002Fyc1\u002Finstitutional-effectiveness\u002Fassessment\u002Fnon-academic","description":"The Administrative, Educational, and Student Support (AESS) unit assessment is a systematic process of collecting, analyzing, and using information to improve unit functions, roles, and services as defined in its mission, goals, and outcomes. It measures Student Learning Outcomes and Operational Outcomes.","items":[],"review_state":"published","title":"AESS Unit Assessment","use_view_action_in_listings":false},{"@id":"http:\u002F\u002F172.16.140.7:8080\u002Fyc1\u002Finstitutional-effectiveness\u002Fassessment\u002Fassessment-spotlight","description":"Highlighting assessment activities in Academic Programs and Administrative, Educational, and Student Support Units","items":[],"review_state":"published","title":"Assessment Spotlights","use_view_action_in_listings":false},{"@id":"http:\u002F\u002F172.16.140.7:8080\u002Fyc1\u002Finstitutional-effectiveness\u002Fassessment\u002Fworkshops","description":"Academic, General Education, and AESS Unit Workshops","items":[],"review_state":"published","title":"Assessment Workshops & Celebrations","use_view_action_in_listings":false},{"@id":"http:\u002F\u002F172.16.140.7:8080\u002Fyc1\u002Finstitutional-effectiveness\u002Fassessment\u002Fgeneral-education-assessment","description":"General education assessment is the systematic and continuous process of collecting and analyzing empirical data in order to improve general education student learning outcomes (SLOs).","items":[],"review_state":"published","title":"General Education Program Assessment","use_view_action_in_listings":false},{"@id":"http:\u002F\u002F172.16.140.7:8080\u002Fyc1\u002Finstitutional-effectiveness\u002Fassessment\u002Freports","description":"Annual institutional Effectiveness reports highlight activities of the three college-wide assessment committees: Academic Assessment Committee (AAC); General Education Assessment Committee (GEAC); and Administrative, Educational, and Student Support Assessment Committee (AESSAC)","items":[],"review_state":"published","title":"Institutional Effectiveness Annual Reports","use_view_action_in_listings":false},{"@id":"http:\u002F\u002F172.16.140.7:8080\u002Fyc1\u002Finstitutional-effectiveness\u002Fassessment\u002Finstitutional-effectiveness-committee","description":"Committee Charge and Membership","items":[],"review_state":"published","title":"Institutional Effectiveness Committee (IEC)","use_view_action_in_listings":false},{"@id":"http:\u002F\u002F172.16.140.7:8080\u002Fyc1\u002Finstitutional-effectiveness\u002Fassessment\u002Fyork-assessment-management-system-yams","description":"","items":[],"review_state":"published","title":"York Assessment Management System (YAMS)","use_view_action_in_listings":false}],"review_state":"published","title":"Assessment"},{"@id":"http:\u002F\u002F172.16.140.7:8080\u002Fyc1\u002Finstitutional-effectiveness\u002Fdata","description":"Key institutional data","items":[{"@id":"http:\u002F\u002F172.16.140.7:8080\u002Fyc1\u002Finstitutional-effectiveness\u002Fdata\u002Fcommon-data-set","description":"York College Common Data Set 2024-2025","items":[],"review_state":"published","title":"Common Data Set","use_view_action_in_listings":false},{"@id":"http:\u002F\u002F172.16.140.7:8080\u002Fyc1\u002Finstitutional-effectiveness\u002Fdata\u002Fdata-dashboards","description":"OIESP Academic Program Dashboards, CUNY Wage Dashboards, and U.S. Census Bureau Employment Dashboard","items":[],"review_state":"published","title":"Data Dashboards","use_view_action_in_listings":false},{"@id":"http:\u002F\u002F172.16.140.7:8080\u002Fyc1\u002Finstitutional-effectiveness\u002Fdata\u002Fkey-metrics","description":"Fall student enrollment snapshots, including academic and demographic data for all enrolled students","items":[],"review_state":"published","title":"Enrollment Snapshots","use_view_action_in_listings":false},{"@id":"http:\u002F\u002F172.16.140.7:8080\u002Fyc1\u002Finstitutional-effectiveness\u002Fdata\u002Ffactbook","description":"Produced annually, the factbook is organized into 15 sections with data including but not limited to enrollment, degrees granted, courses, retention and graduation, faculty, library, and finance","items":[],"review_state":"external","title":"Factbook","use_view_action_in_listings":false},{"@id":"http:\u002F\u002F172.16.140.7:8080\u002Fyc1\u002Finstitutional-effectiveness\u002Fdata\u002Flets-talk-data-session","description":"The Office of Institutional Effectiveness and Strategic Planning hosts the “Let’s Talk Data!” series. Each session focuses on a different topic, with time for Q&A. To register for a session, please click the appropriate link below.","items":[],"review_state":"published","title":"Let's Talk Data!","use_view_action_in_listings":false},{"@id":"http:\u002F\u002F172.16.140.7:8080\u002Fyc1\u002Finstitutional-effectiveness\u002Fdata\u002Fintranet","description":"Three to ten page descriptions & analyses on specific research & assessment topics that align with the strategic plan. Briefs are published throughout the year to communicate assessment activities and promote data transparency at the College.","items":[],"review_state":"published","title":"Research Briefs\u002FReports","use_view_action_in_listings":false},{"@id":"http:\u002F\u002F172.16.140.7:8080\u002Fyc1\u002Finstitutional-effectiveness\u002Fdata\u002Fstudent-outcomes","description":"Student Success Outcomes: One-year retention rates; Four-year and six-year graduation rates","items":[],"review_state":"published","title":"Student Success Outcomes","use_view_action_in_listings":false}],"review_state":"published","title":"Institutional Research"},{"@id":"http:\u002F\u002F172.16.140.7:8080\u002Fyc1\u002Finstitutional-effectiveness\u002Fplanning","description":"One York Goals, Objectives, and Key Performance Indicators","items":[{"@id":"http:\u002F\u002F172.16.140.7:8080\u002Fyc1\u002Finstitutional-effectiveness\u002Fplanning\u002Fstrategic-planning-process-2025-2026","description":"Materials documenting the strategic planning process","items":[],"review_state":"external","title":"Strategic Planning Process, 2025-2026","use_view_action_in_listings":false},{"@id":"http:\u002F\u002F172.16.140.7:8080\u002Fyc1\u002Finstitutional-effectiveness\u002Fplanning\u002Fone-york-strategic-plan-2020-2025","description":"One York 2020-2025 strategic plan, including key performance indicators and alignment with CUNY's \"Lifting New York\" plan. It details the planning process, committee, and meeting materials.","items":[],"review_state":"external","title":"One York Strategic Plan, 2020-2025","use_view_action_in_listings":false},{"@id":"http:\u002F\u002F172.16.140.7:8080\u002Fyc1\u002Finstitutional-effectiveness\u002Fplanning\u002Fannual-operati