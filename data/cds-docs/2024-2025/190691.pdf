stings":false},{"@id":"http:\u002F\u002F172.16.140.7:8080\u002Fyc1\u002Finstitutional-effectiveness\u002Fassessment\u002Fassessment-spotlight","description":"Highlighting assessment activities in Academic Programs and Administrative, Educational, and Student Support Units","items":[],"review_state":"published","title":"Assessment Spotlights","use_view_action_in_listings":false},{"@id":"http:\u002F\u002F172.16.140.7:8080\u002Fyc1\u002Finstitutional-effectiveness\u002Fassessment\u002Fworkshops","description":"Academic, General Education, and AESS Unit Workshops","items":[],"review_state":"published","title":"Assessment Workshops & Celebrations","use_view_action_in_listings":false},{"@id":"http:\u002F\u002F172.16.140.7:8080\u002Fyc1\u002Finstitutional-effectiveness\u002Fassessment\u002Fgeneral-education-assessment","description":"General education assessment is the systematic and continuous process of collecting and analyzing empirical data in order to improve general education student learning outcomes (SLOs).","items":[],"review_state":"published","title":"General Education Program Assessment","use_view_action_in_listings":false},{"@id":"http:\u002F\u002F172.16.140.7:8080\u002Fyc1\u002Finstitutional-effectiveness\u002Fassessment\u002Freports","description":"Annual institutional Effectiveness reports highlight activities of the three college-wide assessment committees: Academic Assessment Committee (AAC); General Education Assessment Committee (GEAC); and Administrative, Educational, and Student Support Assessment Committee (AESSAC)","items":[],"review_state":"published","title":"Institutional Effectiveness Annual Reports","use_view_action_in_listings":false},{"@id":"http:\u002F\u002F172.16.140.7:8080\u002Fyc1\u002Finstitutional-effectiveness\u002Fassessment\u002Finstitutional-effectiveness-committee","description":"Committee Charge and Membership","items":[],"review_state":"published","title":"Institutional Effectiveness Committee (IEC)","use_view_action_in_listings":false},{"@id":"http:\u002F\u002F172.16.140.7:8080\u002Fyc1\u002Finstitutional-effectiveness\u002Fassessment\u002Fyork-assessment-management-system-yams","description":"","items":[],"review_state":"published","title":"York Assessment Management System (YAMS)","use_view_action_in_listings":false}],"review_state":"published","title":"Assessment"},{"@id":"http:\u002F\u002F172.16.140.7:8080\u002Fyc1\u002Finstitutional-effectiveness\u002Fdata","description":"Key institutional data","items":[{"@id":"http:\u002F\u002F172.16.140.7:8080\u002Fyc1\u002Finstitutional-effectiveness\u002Fdata\u002Fcommon-data-set","description":"York College Common Data Set 2024-2025","items":[],"review_state":"published","title":"Common Data Set","use_view_action_in_listings":false},{"@id":"http:\u002F\u002F172.16.140.7:8080\u002Fyc1\u002Finstitutional-effectiveness\u002Fdata\u002Fdata-dashboards","description":"OIESP Academic Program Dashboards, CUNY Wage Dashboards, and U.S. Census Bureau Employment Dashboard","items":[],"review_state":"published","title":"Data Dashboards","use_view_action_in_listings":false},{"@id":"http:\u002F\u002F172.16.140.7:8080\u002Fyc1\u002Finstitutional-effectiveness\u002Fdata\u002Fkey-metrics","description":"Fall student enrollment snapshots, including academic and demographic data for all enrolled students","items":[],"review_state":"published","title":"Enrollment Snapshots","use_view_action_in_listings":false},{"@id":"http:\u002F\u002F172.16.140.7:8080\u002Fyc1\u002Finstitutional-effectiveness\u002Fdata\u002Ffactbook","description":"Produced annually, the factbook is organized into 15 sections with data including but not limited to enrollment, degrees granted, courses, retention and graduation, faculty, library, and finance","items":[],"review_state":"external","title":"Factbook","use_view_action_in_listings":false},{"@id":"http:\u002F\u002F172.16.140.7:8080\u002Fyc1\u002Finstitutional-effectiveness\u002Fdata\u002Flets-talk-data-session","description":"The Office o